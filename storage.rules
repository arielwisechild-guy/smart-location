rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Photos d'annonces: chaque utilisateur peut écrire uniquement dans son dossier annonces/{userId}/...
    match /annonces/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Par défaut, interdire toute écriture non prévue
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
