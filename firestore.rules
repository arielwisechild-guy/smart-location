rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Annonces: toute lecture publique. Création autorisée pour utilisateurs authentifiés.
    // Mise à jour/suppression uniquement par le propriétaire (uid).
    match /annonces/{id} {
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow read: if true;
    }

    // Users: chaque utilisateur peut écrire son propre document.
    match /users/{uid} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
    }

  }
}
